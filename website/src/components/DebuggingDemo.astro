<figure class="debugging-demo">
  <dialog open class="demo-shell" role="group" aria-label="Live Fleury debugger">
    <div class="demo-toolbar">
      <span>Live debugger</span>
      <button type="button" aria-expanded="false">Fullscreen demo</button>
    </div>
    <iframe src="/fleury/debugger-demo.html" title="Try Fleury’s live debugger" loading="lazy"></iframe>
  </dialog>
  <figcaption>This is the debugger used in Fleury CLI apps, rendered in the browser. Frame timings come from this browser session; paint flashing and terminal diagnosis require a native run.</figcaption>
</figure>

<script>
  for (const shell of document.querySelectorAll<HTMLDialogElement>('.debugging-demo .demo-shell')) {
    const button = shell.querySelector('button')!;
    const frame = shell.querySelector('iframe')!;
    let expanded = false;
    let previousOverflow = '';

    function setExpanded(value: boolean) {
      if (expanded === value) return;
      expanded = value;
      // Promote the existing dialog to the top layer. Moving or recreating the
      // iframe would discard the running app and its frame/error history.
      shell.close();
      if (expanded) {
        previousOverflow = document.documentElement.style.overflow;
        document.documentElement.style.overflow = 'hidden';
        shell.setAttribute('role', 'dialog');
        shell.showModal();
      } else {
        shell.open = true;
        shell.setAttribute('role', 'group');
        document.documentElement.style.overflow = previousOverflow;
      }
      button.textContent = expanded ? 'Exit fullscreen' : 'Fullscreen demo';
      button.setAttribute('aria-expanded', String(expanded));
      button.focus({ preventScroll: true });
    }

    button.addEventListener('click', () => setExpanded(!expanded));
    shell.addEventListener('cancel', (event) => {
      event.preventDefault();
      setExpanded(false);
    });
    function connectFrame() {
      // Keyboard events do not bubble out of an iframe. Leave handled Escape
      // keys (for example, clearing a debugger log filter) with the debugger.
      frame.contentDocument?.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !event.defaultPrevented && expanded) {
          event.preventDefault();
          setExpanded(false);
        }
      });
    }
    frame.addEventListener('load', connectFrame);
    if (frame.contentDocument?.readyState === 'complete') connectFrame();
  }
</script>

<style>
  .debugging-demo { width: calc(100% + 12rem); max-width: calc(100vw - 20rem); margin-inline: -6rem; }
  .demo-shell { position: relative; inset: auto; width: 100%; max-width: none; max-height: none; margin: 0; padding: 0; border: 1px solid var(--sl-color-gray-5); border-radius: 10px; overflow: hidden; color: var(--sl-color-text); background: #0b1117; }
  .demo-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .6rem .8rem; border-bottom: 1px solid var(--sl-color-gray-5); font-size: .85rem; }
  button { margin: 0; border: 1px solid var(--sl-color-gray-4); border-radius: 5px; padding: .3rem .65rem; background: #141e27; color: #c8d3e0; font: inherit; cursor: pointer; }
  button:hover { border-color: var(--sl-color-accent); }
  button:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }
  iframe { display: block; width: 100%; height: 550px; margin: 0; border: 0; background: #0b1117; }
  .demo-shell:modal { position: fixed; inset: 0; width: 100vw; height: 100dvh; border: 0; border-radius: 0; display: flex; flex-direction: column; }
  .demo-shell:modal iframe { flex: 1; min-height: 0; height: 100%; }
  .demo-shell::backdrop { background: #0b1117; }
  figcaption { margin-top: .7rem; color: var(--sl-color-gray-2); font-size: .85rem; line-height: 1.6; }
  @media (max-width: 70rem) { .debugging-demo { width: 100%; max-width: 100%; margin-inline: 0; } }
</style>
