---
import ExamplesBundle from './ExamplesBundle.astro';
---
<div class="shutdown-demo" data-shutdown-demo>
  <div class="demo-controls">
    <label>On exit
      <select data-shutdown-policy>
        <option value="default">Close the UI</option>
        <option value="finish">Finish work first</option>
      </select>
    </label>
    <button type="button" data-shutdown-start>Run again</button>
  </div>
  <div class="demo-terminal">
    <div class="command">$ sample-task</div>
    <div data-shutdown-surface class="fleury-host" data-fleury-theme="site" role="group" aria-label="Sample task"></div>
    <div data-shutdown-output role="log" aria-label="Shutdown output"></div>
  </div>
  <div class="demo-controls">
    <span>Simulate</span>
    <button type="button" data-shutdown-signal="interrupt">Ctrl+C</button>
    <button type="button" data-shutdown-signal="terminate">SIGTERM</button>
    <output data-shutdown-status aria-live="polite">UI running</output>
  </div>
</div>
<ExamplesBundle />

<style>
  .shutdown-demo { margin-block: 1.5rem; border: 1px solid var(--sl-color-gray-5); border-radius: .5rem; overflow: hidden; background: var(--sl-color-bg); color: var(--sl-color-text); }
  .demo-controls { display: flex; flex-wrap: wrap; align-items: center; gap: .65rem; padding: .7rem 1rem; font-size: .8rem; }
  .demo-controls > * { margin-block: 0; }
  .demo-controls:first-child { border-bottom: 1px solid var(--sl-color-gray-5); }
  .demo-controls:last-child { border-top: 1px solid var(--sl-color-gray-5); }
  label { display: flex; align-items: center; gap: .7rem; }
  button, select { font: inherit; background: var(--sl-color-gray-6); color: var(--sl-color-text); border: 1px solid var(--sl-color-gray-4); border-radius: .25rem; padding: .25rem .5rem; cursor: pointer; }
  button:hover, button:focus-visible, select:focus-visible { border-color: var(--sl-color-text-accent); }
  button:disabled { opacity: .45; cursor: default; }
  [data-shutdown-start], output { margin-left: auto; }
  output, .command { color: var(--sl-color-gray-2); }
  .demo-terminal { padding: 1rem; min-height: 10rem; font: 14px/1.25 var(--sl-font-mono, ui-monospace, monospace); }
  .shutdown-demo :global(.fleury-host) { width: 100%; height: 8.75em; margin-top: .5rem; font: inherit; }
  [data-shutdown-output] { white-space: pre-wrap; margin-top: .8rem; }
  [hidden] { display: none !important; }
</style>
