---
// One or a few source files beside the thing they render — for guides that
// show a complete, real snippet and its live output at the same time.
//
//   <CodeDemoSplit file="amber_theme.dart">
//     <Fragment slot="code"> ```dart … ``` </Fragment>
//     <FleuryExample slot="demo" id="…" />
//   </CodeDemoSplit>
//
// A terminal-window card. Inline it stacks (or goes two-column when roomy);
// "Expand" opens a full playground — code left, running demo right — in a
// native <dialog> (browser top layer, so no page stacking context can trap
// it behind the backdrop, which is what broke the in-place approach).
//
// The demo in the modal is a FRESH mount, not a moved node: the slotted
// FleuryExample exposes id/cols/rows via its own `.fleury-expand` button, so
// the dialog mounts a new instance with `window.fleuryMountInto(host, id)`
// (the same API FleuryExample's own fullscreen uses) and disposes it on
// close. The inline demo keeps running, untouched. Styling lives in
// src/styles/fleury.css.
interface Props {
  /** Filename shown in the title bar for a single-file example. */
  file?: string;
  /** Browseable source files or test cases for examples whose structure matters. */
  files?: string[];
  /** File selected on first render; defaults to the first file. */
  initialFile?: string;
  /** Caption over the code pane. */
  codeLabel?: string;
  /** Caption over the demo pane. */
  demoLabel?: string;
  /** Keep a complete source file scrollable beside its live example. */
  codeMaxHeight?: string;
  /** Give more room to source or to a larger running example. */
  layout?: 'balanced' | 'demo-wide' | 'code-wide';
}
const {
  file,
  files,
  initialFile,
  codeLabel = 'You write',
  demoLabel = 'Fleury renders',
  codeMaxHeight,
  layout = 'balanced',
} = Astro.props;
const sourceFiles = files?.length ? files : [file ?? 'example.dart'];
const hasFileTabs = sourceFiles.length > 1;
const requestedFileIndex = initialFile ? sourceFiles.indexOf(initialFile) : 0;
const initialFileIndex = requestedFileIndex >= 0 ? requestedFileIndex : 0;
const sourceContents = hasFileTabs
  ? await Promise.all(sourceFiles.map((_, index) => Astro.slots.render(`code-${index}`)))
  : [];

const expandIcon =
  '<svg viewBox="0 0 20 20" width="13" height="13" fill="none" ' +
  'stroke="currentColor" stroke-width="1.7" stroke-linecap="round" ' +
  'stroke-linejoin="round" aria-hidden="true">' +
  '<path d="M12 4h4v4M8 16H4v-4M16 4l-5 5M4 16l5-5"/></svg>';
---

<figure
  class:list={['cds', {
    'cds-demo-wide': layout === 'demo-wide',
    'cds-code-wide': layout === 'code-wide',
    'cds-bounded-code': Boolean(codeMaxHeight),
  }]}
  data-file={sourceFiles[0]}
>
  <header class="cds-bar">
    {hasFileTabs ? (
      <div class="cds-file-tabs" role="tablist" aria-label="Example files">
        {sourceFiles.map((sourceFile, index) => (
          <button
            class="cds-file-tab"
            type="button"
            role="tab"
            aria-selected={index === initialFileIndex ? 'true' : 'false'}
            tabindex={index === initialFileIndex ? 0 : -1}
            data-cds-file-tab={index}
          >
            {sourceFile}
          </button>
        ))}
      </div>
    ) : (
      <span class="cds-file">{sourceFiles[0]}</span>
    )}
    <span class="cds-live"><span class="cds-pulse"></span>live</span>
    <button
      class="cds-toggle"
      type="button"
      aria-haspopup="dialog"
      aria-label="Open the full playground"
      set:html={expandIcon + '<span>Expand</span>'}
    />
  </header>

  <div class="cds-body">
    <section class="cds-pane" data-pane="code">
      <span class="cds-cap">{codeLabel}</span>
      <div class="cds-scroll" style={codeMaxHeight ? `max-height: ${codeMaxHeight}` : undefined}>
        {hasFileTabs ? (
          sourceFiles.map((_, index) => (
            <div
              data-cds-code-file={index}
              hidden={initialFileIndex !== index}
              set:html={sourceContents[index]}
            />
          ))
        ) : (
          <slot name="code" />
        )}
      </div>
    </section>

    <section class="cds-pane" data-pane="demo">
      <span class="cds-cap">{demoLabel}</span>
      <div class="cds-scroll cds-demo"><slot name="demo" /></div>
    </section>
  </div>
</figure>

<script>
  import { attachPreferencesTest } from '../scripts/preferences-test-runner';
  // Keep the full file available while starting at the part the demo teaches.
  const positionSource = (scope: ParentNode) => {
    const source = Array.from(scope.querySelectorAll<HTMLElement>('[data-code-focus-line]'))
      .find(source => source.getClientRects().length > 0);
    const scroll = scope.querySelector<HTMLElement>('.cds-scroll');
    if (!scroll) return;
    const line = source?.querySelectorAll<HTMLElement>('.ec-line')[
      Number(source.dataset.codeFocusLine) - 1
    ];
    scroll.scrollTop = line
      ? scroll.scrollTop + line.getBoundingClientRect().top
        - scroll.getBoundingClientRect().top - scroll.clientHeight / 3
      : 0;
  };
  const wireFileTabs = (scope: ParentNode) => {
    const tabs = Array.from(
      scope.querySelectorAll<HTMLButtonElement>('[data-cds-file-tab]'),
    );
    const panes = Array.from(
      scope.querySelectorAll<HTMLElement>('[data-cds-code-file]'),
    );
    if (tabs.length < 2 || panes.length < 2) return;

    const select = (index: number, focus = false) => {
      tabs.forEach((tab, tabIndex) => {
        const selected = tabIndex === index;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
        if (selected && focus) tab.focus();
      });
      panes.forEach((pane, paneIndex) => {
        pane.hidden = paneIndex !== index;
      });
      requestAnimationFrame(() => positionSource(scope));
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(index));
      tab.addEventListener('keydown', (event) => {
        let next = index;
        if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') {
          next = (index - 1 + tabs.length) % tabs.length;
        } else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        else return;
        event.preventDefault();
        select(next, true);
      });
    });
  };

  for (const root of document.querySelectorAll<HTMLElement>('.cds')) {
    if (root.dataset.cdsWired === 'true') continue;
    root.dataset.cdsWired = 'true';
    wireFileTabs(root);
    document.fonts.ready.then(() => positionSource(root));
    const toggle = root.querySelector<HTMLButtonElement>('.cds-toggle')!;
    const file = root.dataset.file ?? '';
    const codeLabel =
      root.querySelector('.cds-pane[data-pane="code"] .cds-cap')?.textContent ??
      'You write';
    const demoLabel =
      root.querySelector('.cds-pane[data-pane="demo"] .cds-cap')?.textContent ??
      'Fleury renders';

    toggle.addEventListener('click', () => {
      // The slotted FleuryExample carries the example's identity + size on
      // its own expand button; reuse it to mount a fresh instance.
      const fx = root.querySelector<HTMLElement>('.fleury-expand');
      const id = fx?.dataset.id;
      const cols = Math.min(Math.round((+(fx?.dataset.cols ?? 60)) * 1.5), 160);
      const rows = Math.min(Math.round((+(fx?.dataset.rows ?? 12)) * 1.4), 46);
      const theme = fx?.dataset.theme ?? 'dark';

      const dlg = document.createElement('dialog');
      dlg.className = 'cds-modal';
      for (const layout of ['cds-demo-wide', 'cds-code-wide']) {
        if (root.classList.contains(layout)) dlg.classList.add(layout);
      }

      const bar = document.createElement('div');
      bar.className = 'cds-modal-bar';
      const sourceHeader = root.querySelector<HTMLElement>(
        '.cds-file-tabs, .cds-file',
      );
      const fileEl = sourceHeader?.cloneNode(true) ?? document.createElement('span');
      if (!sourceHeader) {
        (fileEl as HTMLElement).className = 'cds-file';
        fileEl.textContent = file;
      }
      const close = document.createElement('button');
      close.type = 'button';
      close.className = 'cds-modal-close';
      close.innerHTML = 'Close <kbd>Esc</kbd>';
      bar.append(fileEl, close);

      const body = document.createElement('div');
      body.className = 'cds-modal-body';

      const codeCol = document.createElement('section');
      codeCol.className = 'cds-modal-pane';
      const codeCap = document.createElement('span');
      codeCap.className = 'cds-cap';
      codeCap.textContent = codeLabel;
      const codeScroll = document.createElement('div');
      codeScroll.className = 'cds-scroll';
      const codeSrc = root.querySelector(
        '.cds-pane[data-pane="code"] .cds-scroll',
      );
      if (codeSrc) {
        codeScroll.append(...Array.from(codeSrc.childNodes, node => node.cloneNode(true)));
      }
      codeCol.append(codeCap, codeScroll);

      const demoCol = document.createElement('section');
      demoCol.className = 'cds-modal-pane cds-modal-demo';
      const demoCap = document.createElement('span');
      demoCap.className = 'cds-cap';
      demoCap.textContent = demoLabel;
      const host = document.createElement('div');
      host.className = 'fleury-host';
      host.dataset.fleuryTheme = theme;
      host.style.cssText =
        `width:${cols}ch;height:${(rows * 1.25).toFixed(1)}em;` +
        'max-width:100%;max-height:100%';
      if (fx?.dataset.test === 'preferences') {
        const hostWrap = document.createElement('div');
        hostWrap.className = 'fleury-host-wrap';
        hostWrap.append(host);
        demoCol.append(demoCap, hostWrap);
      } else {
        demoCol.append(demoCap, host);
      }

      body.append(codeCol, demoCol);
      dlg.append(bar, body);
      document.body.appendChild(dlg);
      wireFileTabs(dlg);
      dlg.showModal();
      requestAnimationFrame(() => positionSource(dlg));
      const disposeTest = fx?.dataset.test === 'preferences'
        ? attachPreferencesTest(host, dlg)
        : undefined;

      const handle =
        id && (window as any).fleuryMountInto
          ? (window as any).fleuryMountInto(host, id)
          : null;

      // Send focus straight into the running demo so the keyboard drives it
      // immediately — otherwise showModal parks focus on the Close button and
      // the reader has to click the demo first. The mount's input element
      // (a focus-capture textarea) may appear a frame after mount, so aim
      // twice: this frame and shortly after.
      const focusDemo = () => {
        const target =
          host.querySelector<HTMLElement>('textarea, canvas, [tabindex]') ??
          host;
        target?.focus?.();
      };
      requestAnimationFrame(focusDemo);
      setTimeout(focusDemo, 80);

      // Explicit, idempotent teardown wired to every close path. We do NOT
      // rely on the dialog's 'close' event — it does not fire in every engine
      // (observed here), which would strand the dialog and leak the mount.
      let dismissed = false;
      const dismiss = () => {
        if (dismissed) return;
        dismissed = true;
        disposeTest?.();
        try {
          handle?.dispose?.();
        } catch {
          /* a broken example must not block teardown */
        }
        document.removeEventListener('keydown', onKey);
        if (dlg.open) dlg.close();
        dlg.remove();
      };
      const onKey = (e: KeyboardEvent) => {
        if (e.key === 'Escape') dismiss();
      };
      close.addEventListener('click', dismiss);
      // Backdrop click: the dialog element itself receives clicks that land
      // outside its content box.
      dlg.addEventListener('click', (e) => {
        if (e.target === dlg) dismiss();
      });
      // Esc: native dialogs fire 'cancel' before closing; preventDefault so
      // our teardown owns the close. The document listener is the backstop.
      dlg.addEventListener('cancel', (e) => {
        e.preventDefault();
        dismiss();
      });
      document.addEventListener('keydown', onKey);
    });
  }
</script>
