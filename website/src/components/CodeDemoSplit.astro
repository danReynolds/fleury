---
// One source file beside the thing it renders — for guides that show a
// complete, real snippet and its live output at the same time.
//
//   <CodeDemoSplit file="amber_theme.dart">
//     <Fragment slot="code"> ```dart … ``` </Fragment>
//     <FleuryExample slot="demo" id="…" />
//   </CodeDemoSplit>
//
// A terminal-window card. Inline it stacks (or goes two-column when roomy);
// "Expand" opens a full playground — code left, running demo right — in a
// native <dialog> (browser top layer, so no page stacking context can trap
// it behind the backdrop, which is what broke the in-place approach).
//
// The demo in the modal is a FRESH mount, not a moved node: the slotted
// FleuryExample exposes id/cols/rows via its own `.fleury-expand` button, so
// the dialog mounts a new instance with `window.fleuryMountInto(host, id)`
// (the same API FleuryExample's own fullscreen uses) and disposes it on
// close. The inline demo keeps running, untouched. Styling lives in
// src/styles/fleury.css.
interface Props {
  /** Filename shown in the title bar, e.g. "amber_theme.dart". */
  file: string;
  /** Caption over the code pane. */
  codeLabel?: string;
  /** Caption over the demo pane. */
  demoLabel?: string;
}
const { file, codeLabel = 'You write', demoLabel = 'Fleury renders' } =
  Astro.props;

const expandIcon =
  '<svg viewBox="0 0 20 20" width="13" height="13" fill="none" ' +
  'stroke="currentColor" stroke-width="1.7" stroke-linecap="round" ' +
  'stroke-linejoin="round" aria-hidden="true">' +
  '<path d="M12 4h4v4M8 16H4v-4M16 4l-5 5M4 16l5-5"/></svg>';
---

<figure class="cds" data-file={file}>
  <header class="cds-bar">
    <span class="cds-file">{file}</span>
    <span class="cds-live"><span class="cds-pulse"></span>live</span>
    <button
      class="cds-toggle"
      type="button"
      aria-haspopup="dialog"
      aria-label="Open the full playground"
      set:html={expandIcon + '<span>Expand</span>'}
    />
  </header>

  <div class="cds-body">
    <section class="cds-pane" data-pane="code">
      <span class="cds-cap">{codeLabel}</span>
      <div class="cds-scroll"><slot name="code" /></div>
    </section>

    <div class="cds-seam" aria-hidden="true">
      <span class="cds-seam-word">renders</span>
      <span class="cds-seam-arrow">→</span>
    </div>

    <section class="cds-pane" data-pane="demo">
      <span class="cds-cap">{demoLabel}</span>
      <div class="cds-scroll cds-demo"><slot name="demo" /></div>
    </section>
  </div>
</figure>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('.cds')) {
    const toggle = root.querySelector<HTMLButtonElement>('.cds-toggle')!;
    const file = root.dataset.file ?? '';
    const codeLabel =
      root.querySelector('.cds-pane[data-pane="code"] .cds-cap')?.textContent ??
      'You write';
    const demoLabel =
      root.querySelector('.cds-pane[data-pane="demo"] .cds-cap')?.textContent ??
      'Fleury renders';

    toggle.addEventListener('click', () => {
      // The slotted FleuryExample carries the example's identity + size on
      // its own expand button; reuse it to mount a fresh instance.
      const fx = root.querySelector<HTMLElement>('.fleury-expand');
      const id = fx?.dataset.id;
      const cols = Math.min(Math.round((+(fx?.dataset.cols ?? 60)) * 1.5), 160);
      const rows = Math.min(Math.round((+(fx?.dataset.rows ?? 12)) * 1.4), 46);
      const theme = fx?.dataset.theme ?? 'dark';

      const dlg = document.createElement('dialog');
      dlg.className = 'cds-modal';

      const bar = document.createElement('div');
      bar.className = 'cds-modal-bar';
      const fileEl = document.createElement('span');
      fileEl.className = 'cds-file';
      fileEl.textContent = file;
      const close = document.createElement('button');
      close.type = 'button';
      close.className = 'cds-modal-close';
      close.innerHTML = 'Close <kbd>Esc</kbd>';
      bar.append(fileEl, close);

      const body = document.createElement('div');
      body.className = 'cds-modal-body';

      const codeCol = document.createElement('section');
      codeCol.className = 'cds-modal-pane';
      const codeCap = document.createElement('span');
      codeCap.className = 'cds-cap';
      codeCap.textContent = codeLabel;
      const codeScroll = document.createElement('div');
      codeScroll.className = 'cds-scroll';
      const codeSrc = root.querySelector(
        '.cds-pane[data-pane="code"] .cds-scroll',
      );
      if (codeSrc) codeScroll.append(codeSrc.cloneNode(true));
      codeCol.append(codeCap, codeScroll);

      const seam = document.createElement('div');
      seam.className = 'cds-seam';
      seam.setAttribute('aria-hidden', 'true');
      seam.innerHTML =
        '<span class="cds-seam-word">renders</span>' +
        '<span class="cds-seam-arrow">→</span>';

      const demoCol = document.createElement('section');
      demoCol.className = 'cds-modal-pane cds-modal-demo';
      const demoCap = document.createElement('span');
      demoCap.className = 'cds-cap';
      demoCap.textContent = demoLabel;
      const host = document.createElement('div');
      host.className = 'fleury-host';
      host.dataset.fleuryTheme = theme;
      host.style.cssText =
        `width:${cols}ch;height:${(rows * 1.25).toFixed(1)}em;` +
        'max-width:100%;max-height:100%';
      demoCol.append(demoCap, host);

      body.append(codeCol, seam, demoCol);
      dlg.append(bar, body);
      document.body.appendChild(dlg);
      dlg.showModal();

      const handle =
        id && (window as any).fleuryMountInto
          ? (window as any).fleuryMountInto(host, id)
          : null;

      // Explicit, idempotent teardown wired to every close path. We do NOT
      // rely on the dialog's 'close' event — it does not fire in every engine
      // (observed here), which would strand the dialog and leak the mount.
      let dismissed = false;
      const dismiss = () => {
        if (dismissed) return;
        dismissed = true;
        try {
          handle?.dispose?.();
        } catch {
          /* a broken example must not block teardown */
        }
        document.removeEventListener('keydown', onKey);
        if (dlg.open) dlg.close();
        dlg.remove();
      };
      const onKey = (e: KeyboardEvent) => {
        if (e.key === 'Escape') dismiss();
      };
      close.addEventListener('click', dismiss);
      // Backdrop click: the dialog element itself receives clicks that land
      // outside its content box.
      dlg.addEventListener('click', (e) => {
        if (e.target === dlg) dismiss();
      });
      // Esc: native dialogs fire 'cancel' before closing; preventDefault so
      // our teardown owns the close. The document listener is the backstop.
      dlg.addEventListener('cancel', (e) => {
        e.preventDefault();
        dismiss();
      });
      document.addEventListener('keydown', onKey);
    });
  }
</script>
