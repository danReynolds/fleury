---
// One source file beside the thing it renders — for guides that show a
// complete, real snippet and its live output at the same time.
//
//   <CodeDemoSplit file="amber_theme.dart">
//     <Fragment slot="code"> ```dart … ``` </Fragment>
//     <FleuryExample slot="demo" id="…" />
//   </CodeDemoSplit>
//
// A terminal-window card. Inline it stacks (or goes two-column when roomy);
// one "Expand" in the title bar opens a full playground modal — code left,
// running demo right — over a dimmed backdrop.
//
// Modal mechanics: the figure is promoted to a fixed overlay IN PLACE by a
// class; NOTHING is moved. Moving the demo node (or portaling the figure)
// disconnects it, and FleuryExample re-hydrates a second instance on
// reconnect — so the live app stays exactly where it mounted and simply
// gets a bigger frame. A backdrop is added to <body>; Esc, the backdrop,
// and the toolbar button all close. Styling lives in src/styles/fleury.css.
interface Props {
  /** Filename shown in the title bar, e.g. "amber_theme.dart". */
  file: string;
  /** Caption over the code pane. */
  codeLabel?: string;
  /** Caption over the demo pane. */
  demoLabel?: string;
}
const { file, codeLabel = 'You write', demoLabel = 'Fleury renders' } =
  Astro.props;

const expandIcon =
  '<svg viewBox="0 0 20 20" width="13" height="13" fill="none" ' +
  'stroke="currentColor" stroke-width="1.7" stroke-linecap="round" ' +
  'stroke-linejoin="round" aria-hidden="true">' +
  '<path d="M12 4h4v4M8 16H4v-4M16 4l-5 5M4 16l5-5"/></svg>';
---

<figure class="cds">
  <header class="cds-bar">
    <span class="cds-file">{file}</span>
    <span class="cds-live"><span class="cds-pulse"></span>live</span>
    <button class="cds-toggle" type="button" aria-label="Expand to full screen">
      <span class="cds-toggle-open" set:html={expandIcon + '<span>Expand</span>'}
      ></span>
      <span class="cds-toggle-close">Close <kbd>Esc</kbd></span>
    </button>
  </header>

  <div class="cds-body">
    <section class="cds-pane" data-pane="code">
      <span class="cds-cap">{codeLabel}</span>
      <div class="cds-scroll"><slot name="code" /></div>
    </section>

    <div class="cds-seam" aria-hidden="true">
      <span class="cds-seam-word">renders</span>
      <span class="cds-seam-arrow">→</span>
    </div>

    <section class="cds-pane" data-pane="demo">
      <span class="cds-cap">{demoLabel}</span>
      <div class="cds-scroll cds-demo"><slot name="demo" /></div>
    </section>
  </div>
</figure>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('.cds')) {
    const toggle = root.querySelector<HTMLButtonElement>('.cds-toggle')!;
    let backdrop: HTMLElement | null = null;

    const close = () => {
      if (!root.classList.contains('is-fs')) return;
      root.classList.remove('is-fs');
      document.body.classList.remove('cds-modal-open');
      backdrop?.remove();
      backdrop = null;
      toggle.setAttribute('aria-label', 'Expand to full screen');
    };
    const open = () => {
      if (root.classList.contains('is-fs')) return;
      backdrop = document.createElement('div');
      backdrop.className = 'cds-backdrop';
      backdrop.addEventListener('click', close);
      document.body.appendChild(backdrop);
      document.body.classList.add('cds-modal-open');
      root.classList.add('is-fs');
      toggle.setAttribute('aria-label', 'Exit full screen');
    };

    toggle.addEventListener('click', () =>
      root.classList.contains('is-fs') ? close() : open(),
    );
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
  }
</script>
