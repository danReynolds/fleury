---
// Shows one of the Testing guide's tests as the reader's own test file. The
// source is the real test under examples/test/testing/, which `dart test` runs
// (test/testing_guide_test.dart runs them all). Only its import of the guide's
// example library is respelled as the `package:my_app/` import a reader's app
// uses, with the package imports kept sorted; docregion markers are dropped.
//
//   <TestingGuideCode file="counter_test.dart" />
import { Code } from '@astrojs/starlight/components';

const tests = import.meta.glob<string>('../../examples/test/testing/*_test.dart', {
  query: '?raw', import: 'default', eager: true,
});
interface Props { file: string }
const { file } = Astro.props;
const source = tests[`../../examples/test/testing/${file}`];
if (!source) throw new Error(`Testing guide test is missing: ${file}`);
const example = /^import 'package:fleury_doc_examples\/testing\/(\w+\.dart)';$/m;
if (!example.test(source)) {
  throw new Error(`${file} must import its example from package:fleury_doc_examples/testing/`);
}
const code = source
  .replace(/^[ \t]*\/\/ #(end)?docregion .*\r?\n/gm, '')
  .replace(example, "import 'package:my_app/$1';")
  .replace(/(?:^import 'package:[^']+';\n)+/m, (block) =>
    block.trimEnd().split('\n').sort().join('\n') + '\n')
  .trimEnd();
---
<Code code={code} lang="dart" title={`test/${file}`} wrap />
