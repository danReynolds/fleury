---
import DemoSource from './DemoSource.astro';
const sources = import.meta.glob<string>('../../examples/{lib,test}/input/*.dart', {
  query: '?raw', import: 'default', eager: true,
});
interface Props { file: string; test?: boolean }
const { file, test = false } = Astro.props;
const code = sources[`../../examples/${test ? 'test' : 'lib'}/input/${file}`];
if (!code) throw new Error(`Input guide file is missing: ${file}`);
---
<DemoSource code={code} focus={test ? undefined : 'Widget build('} />
