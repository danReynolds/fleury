---
import DemoSource from './DemoSource.astro';
const sources = import.meta.glob<string>('../../examples/lib/input/*.dart', {
  query: '?raw', import: 'default', eager: true,
});
interface Props { file: string; full?: boolean; region?: string }
const { file, full = false, region = 'focus' } = Astro.props;
const code = sources[`../../examples/lib/input/${file}`];
if (!code) throw new Error(`Input guide file is missing: ${file}`);
const regions = Array.from(code.matchAll(/^[ \t]*\/\/ #docregion (\w+)\r?\n([\s\S]*?)^[ \t]*\/\/ #enddocregion \1[ \t]*$/gm));
const excerpt = regions.filter(match => match[1] === region).map(match => match[2].trimEnd()).join('\n\n');
if (!full && !excerpt) throw new Error(`Input guide region ${region} is missing: ${file}`);
const lines = excerpt.split('\n');
const indent = Math.min(...lines.filter(line => line.trim()).map(line => line.match(/^ */)![0].length));
const focused = lines.map(line => line.slice(indent)).join('\n');
---
<DemoSource code={full ? code : focused} />
