---
import DemoSource from './DemoSource.astro';
const sources = import.meta.glob<string>('../../examples/doc_snippets/terminal_modes/*.dart', {
  query: '?raw', import: 'default', eager: true,
});
interface Props { file: string; }
const { file } = Astro.props;
const code = sources[`../../examples/doc_snippets/terminal_modes/${file}`];
if (!code) throw new Error(`Terminal modes source is missing: ${file}`);
---
<DemoSource code={code} />
