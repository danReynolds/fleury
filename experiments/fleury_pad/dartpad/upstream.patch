+  /// Analyze an embedding application's bounded virtual project. Paths in the
+  /// response are logical project names, never server filesystem paths.
+  Future<Map<String, dynamic>> analyzeFiles(Map<String, String> files) async {
+    final sources = _getOverlayMapWithPaths(files);
+    await _loadSources(sources);
+    final issues = <Map<String, dynamic>>[];
+    for (final entry in files.entries) {
+      final errors = await analysisServer.analysis.getErrors(
+        _getPathFromName(entry.key),
+      );
+      for (final error in errors.errors) {
+        if (error.severity == 'INFO') continue;
+        issues.add({
+          'file': entry.key,
+          'kind': error.severity.toLowerCase(),
+          'message': utils.normalizeImports(error.message),
+          'code': error.code.toLowerCase(),
+          'location': {
+            'charStart': error.location.offset,
+            'charLength': error.location.length,
+            'line': error.location.startLine,
+            'column': error.location.startColumn,
+          },
+        });
+      }
+    }
+    return {'issues': issues};
+  }
